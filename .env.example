# Copy to .env and fill in. Every value has a safe default for local dev, so you can run with
# an empty .env and add these as you go to production.

# --- storage ---------------------------------------------------------------
# Dev/local: SQLite (this file). Production: set DATABASE_URL to a Postgres/Supabase connection
# string and the app uses Postgres (pooled) instead — migrations auto-apply on startup.
MCPWATCH_DB=mcpwatch.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# For Supabase, use the "Connection pooling" (transaction/session) URL from Project Settings.
MCPWATCH_PG_POOL_MAX=10

# --- grading engine (mcp-probe) --------------------------------------------
MCP_PROBE_PATH=C:/Users/user/Desktop/Building/mcp-probe
MCPWATCH_PROBE_TIMEOUT=25
MCPWATCH_MAX_RESPONSE_BYTES=5000000

# --- security (IMPORTANT for a hosted deployment) --------------------------
# Allow monitoring private/loopback IPs (localhost). Fine for self-hosting; NEVER on a hosted
# multi-tenant deployment (SSRF).
MCPWATCH_SSRF_ALLOW_PRIVATE=false
# Allow stdio monitors (running a user's launch command = code execution). Self-host only;
# the hosted control plane must keep this false and sandbox stdio in an isolated worker.
MCPWATCH_ALLOW_STDIO=true

# --- auth ------------------------------------------------------------------
MCPWATCH_SESSION_TTL=2592000        # 30 days
MCPWATCH_AUTH_MAX_ATTEMPTS=8        # per IP+email, per window
MCPWATCH_AUTH_WINDOW=300

# --- alerts (Resend) -------------------------------------------------------
# Without a key, alerts are logged instead of sent — everything else still works.
# RESEND_API_KEY=re_...
MCPWATCH_ALERT_FROM=MCPWatch <alerts@yourdomain.com>
MCPWATCH_ALERT_COOLDOWN=900         # per-rule dedup window (seconds)

# --- incidents -------------------------------------------------------------
MCPWATCH_INCIDENT_THRESHOLD=2       # consecutive failures before an incident opens

# --- public URLs & scheduler ----------------------------------------------
MCPWATCH_BASE_URL=http://localhost:8000
MCPWATCH_SCHEDULER_TOKEN=change-me-to-a-long-random-string

# --- billing (LemonSqueezy — merchant of record, pays out to Pakistan) -----
# LEMONSQUEEZY_STORE_URL=https://yourstore.lemonsqueezy.com
# LEMONSQUEEZY_WEBHOOK_SECRET=whsec_...
# LEMONSQUEEZY_VARIANT_PRO=123456
# LEMONSQUEEZY_VARIANT_TEAM=123457
